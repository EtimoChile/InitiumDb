#!/bin/sh
# Launcher for idb-prepare. Uses JAVA_HOME when set, otherwise java from PATH (Java 25 or later).
# Extra JVM options can be passed through IDB_JAVA_OPTS.
script=$0
while [ -h "$script" ]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
APP_HOME=$(cd "$(dirname "$script")/.." && pwd -P)
SEP=":"
case "$(uname -s)" in
  CYGWIN*|MINGW*|MSYS*) APP_HOME=$(cygpath -w "$APP_HOME"); SEP=";" ;;
esac
if [ -n "$JAVA_HOME" ]; then JAVA="$JAVA_HOME/bin/java"; else JAVA=java; fi
exec "$JAVA" $IDB_JAVA_OPTS -cp "$APP_HOME/lib/*${SEP}$APP_HOME/drivers/*" cl.etimo.initiumdb.cli.IdbPrepare "$@"
